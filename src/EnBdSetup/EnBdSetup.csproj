<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>en-BD-Setup</AssemblyName>
    <RootNamespace>EnBdSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Product>English (Bangladesh) Setup</Product>
    <Company>ekushey.org</Company>
    <Description>Installs English (Bangladesh) [en-BD] locale and US with Taka sign keyboard layout.</Description>
    <Copyright>Copyright (c) 2026 ekushey.org</Copyright>
    <VersionPrefix>1.0.1</VersionPrefix>
    <InformationalVersion>V1.0.1e</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sysglobl" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\cldr\en_BD.xml">
      <LogicalName>EnBdSetup.cldr.en_BD.xml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\build\kbd\x86\kbdusbd.dll">
      <LogicalName>EnBdSetup.kbd.x86.kbdusbd.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\build\kbd\wow64\kbdusbd.dll">
      <LogicalName>EnBdSetup.kbd.wow64.kbdusbd.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\build\kbd\x64\kbdusbd.dll">
      <LogicalName>EnBdSetup.kbd.x64.kbdusbd.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\build\kbd\arm64\kbdusbd.dll">
      <LogicalName>EnBdSetup.kbd.arm64.kbdusbd.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
